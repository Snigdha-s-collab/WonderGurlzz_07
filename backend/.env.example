# =======================================================
# OnePatient Backend - Qwen2.5-VL Hosted Inference Config
# =======================================================

# Provider Options:
#
# Option A: SiliconFlow (Recommended for exact Qwen/Qwen2.5-VL-7B-Instruct with 20M free tokens)
# INFERENCE_API_BASE_URL=https://api.siliconflow.cn/v1
# INFERENCE_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#
# Option B: OpenRouter (Universal gateway, pay-as-you-go ~₹0.02 per scan)
# INFERENCE_API_BASE_URL=https://openrouter.ai/api/v1
# INFERENCE_MODEL=qwen/qwen-2.5-vl-72b-instruct
# (or qwen/qwen3-vl-8b-instruct)
#
# Option C: Fireworks AI
# INFERENCE_API_BASE_URL=https://api.fireworks.ai/inference/v1
# INFERENCE_MODEL=accounts/fireworks/models/qwen2p5-vl-7b-instruct

INFERENCE_API_BASE_URL=https://openrouter.ai/api/v1
INFERENCE_API_KEY=your_hosted_inference_api_key_here
INFERENCE_MODEL=qwen/qwen-2.5-vl-7b-instruct
REQUEST_TIMEOUT_SECONDS=60.0

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
